{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.26",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "supabase": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "katman": "depcruise src --config .dependency-cruiser.cjs",
    "kullanilmayan": "knip --no-progress",
    "kontrol": "npm run typecheck && npm run lint && npm run katman && npm run kullanilmayan && npm test",
    "test": "jest --coverage",
    "supabase": "supabase --workdir ..",
    "tipler": "(echo '// Bu dosya `npm run tipler` ile Supabase şemasından üretilir; elle değiştirmeyin.' && supabase --workdir .. gen types typescript --remote --schema public) > src/types/database.ts && prettier --write src/types/database.ts",
    "prepare": "cd .. && husky app/.husky",
    "test:rls": "jest --config jest.rls.config.js --runInBand"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/",
      "/rls-tests/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/components/**",
      "!src/**/__tests__/**",
      "!src/services/index.ts",
      "!src/services/supabase.ts",
      "!src/services/remote/**",
      "!src/models/index.ts",
      "!src/errors/index.ts",
      "!src/config.ts",
      "!src/test-utils/**",
      "!src/types/**"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      },
      "./src/services/": {
        "lines": 90,
        "branches": 85
      },
      "./src/models/": {
        "lines": 90,
        "branches": 85
      },
      "./src/validation/": {
        "lines": 90,
        "branches": 85
      },
      "./src/utils/": {
        "lines": 90,
        "branches": 85
      },
      "./src/hooks/": {
        "lines": 90,
        "branches": 85
      }
    },
    "globalSetup": "<rootDir>/jest.global-setup.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=-1",
      "prettier --write",
      "jest --findRelatedTests --passWithNoTests"
    ],
    "*.{js,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  }
}
